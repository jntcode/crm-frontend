# Copy to .env.local. Every value is optional — sensible localhost defaults
# are used when these are unset.

# Backend base URL used for all non-auth API calls.
NEXT_PUBLIC_API_URL=http://localhost:8080/api

# Backend auth base URL (login/register/google/profile).
NEXT_PUBLIC_AUTH_API_URL=http://localhost:8080/api/auth

# Enables the landing-page "Try Demo" button. These must match a real account
# on the backend you are pointing at (e.g. the dev-seeded admin@crm.com).
# Leave unset to hide demo failures — the frontend never fabricates a session.
# NEXT_PUBLIC_DEMO_EMAIL=admin@crm.com
# NEXT_PUBLIC_DEMO_PASSWORD=secret123

# Google Sign-In button on the login page (must match the backend GOOGLE_CLIENT_ID).
# NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com

# Optional real email sending via EmailJS. When all three are set the emails
# page offers "Send & log"; otherwise it only logs and says so.
# NEXT_PUBLIC_EMAILJS_SERVICE_ID=
# NEXT_PUBLIC_EMAILJS_TEMPLATE_ID=
# NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=
